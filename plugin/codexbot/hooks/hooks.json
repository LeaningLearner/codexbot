{
  "description": "Queue Codex lifecycle events for the local CodexBot QQ companion.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /D /S /C \"\"${PLUGIN_ROOT}\\hooks\\entry.cmd\"\"",
            "commandWindows": "cmd.exe /D /S /C \"\"${PLUGIN_ROOT}\\hooks\\entry.cmd\"\"",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /D /S /C \"\"${PLUGIN_ROOT}\\hooks\\entry.cmd\"\"",
            "commandWindows": "cmd.exe /D /S /C \"\"${PLUGIN_ROOT}\\hooks\\entry.cmd\"\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /D /S /C \"\"${PLUGIN_ROOT}\\hooks\\entry.cmd\"\"",
            "commandWindows": "cmd.exe /D /S /C \"\"${PLUGIN_ROOT}\\hooks\\entry.cmd\"\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /D /S /C \"\"${PLUGIN_ROOT}\\hooks\\entry.cmd\"\"",
            "commandWindows": "cmd.exe /D /S /C \"\"${PLUGIN_ROOT}\\hooks\\entry.cmd\"\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /D /S /C \"\"${PLUGIN_ROOT}\\hooks\\entry.cmd\"\"",
            "commandWindows": "cmd.exe /D /S /C \"\"${PLUGIN_ROOT}\\hooks\\entry.cmd\"\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /D /S /C \"\"${PLUGIN_ROOT}\\hooks\\entry.cmd\"\"",
            "commandWindows": "cmd.exe /D /S /C \"\"${PLUGIN_ROOT}\\hooks\\entry.cmd\"\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
